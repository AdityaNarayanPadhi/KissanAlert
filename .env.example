# Google Gemini API Keys (Rotates automatically across all 3 keys)
VITE_GEMINI_API_KEY_1=your_gemini_key_1_here
VITE_GEMINI_API_KEY_2=your_gemini_key_2_here
VITE_GEMINI_API_KEY_3=your_gemini_key_3_here
VITE_GEMINI_API_KEY=your_gemini_default_key_here

# Google Maps Platform Weather API Key
VITE_GOOGLE_WEATHER_API_KEY=your_google_weather_key_here

# OpenWeatherMap.org API Keys (Automatic rotation on 401/429/errors)
VITE_OPENWEATHER_API_KEY_1=your_openweathermap_key_1_here
VITE_OPENWEATHER_API_KEY_2=your_openweathermap_key_2_here

# Supabase Cloud Database Config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
