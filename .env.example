# Google Gemini API Key (Allows users without a personal key to use AI features freely)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# IndianAPI Weather Key (https://weather.indianapi.in)
VITE_INDIAN_API_KEY=your_indian_api_key_here

# Supabase Cloud Database Config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
